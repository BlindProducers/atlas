 void DxgiAdapters::updateAdapters()
 {
+    // Atlas: the adapters' Direct3D and Direct2D devices are made the first
+    // time something asks for an adapter (createAdaptersIfNeeded), not with the
+    // first window. Making them loads the graphics driver into the host, which
+    // holds the message thread while it does (a fifth of a second where the
+    // driver checks its own signature first), and a window the software
+    // renderer draws never asks: its vblank thread reads getDxgiAdapters.
+    if (! adaptersWanted)
+    {
+        if (factory == nullptr || ! factory->IsCurrent())
+            factory = makeDxgiFactory();
+
+        return;
+    }
+
     if (factory != nullptr && factory->IsCurrent() && ! adapterArray.isEmpty())
         return;
 
@@ -170,8 +184,45 @@ void DxgiAdapters::releaseAdapters()
     adapterArray.clear();
 }
 
+void DxgiAdapters::createAdaptersIfNeeded() const
+{
+    if (adaptersCreated)
+        return;
+
+    const std::lock_guard lock { adapterCreation };
+
+    if (adaptersCreated)
+        return;
+
+    adaptersWanted = true;
+    const_cast<DxgiAdapters*> (this)->updateAdapters();
+    adaptersCreated = true;
+}
+
+std::vector<ComSmartPtr<IDXGIAdapter1>> DxgiAdapters::getDxgiAdapters() const
+{
+    std::vector<ComSmartPtr<IDXGIAdapter1>> result;
+
+    if (factory == nullptr)
+        return result;
+
+    for (UINT i = 0;; ++i)
+    {
+        ComSmartPtr<IDXGIAdapter1> dxgiAdapter;
+
+        if (FAILED (factory->EnumAdapters1 (i, dxgiAdapter.resetAndGetPointerAddress())) || dxgiAdapter == nullptr)
+            break;
+
+        result.push_back (dxgiAdapter);
+    }
+
+    return result;
+}
+
