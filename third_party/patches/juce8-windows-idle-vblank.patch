+    // Atlas: a window says when it starts and stops waiting for a vblank (a
+    // paint pending, or a VBlankListener of its own), and the threads deliver
+    // vblanks only while one waits. Idle, the message thread is left alone.
+    void setWaiting (const ComponentPeer::VBlankListener& listener, bool waiting)
+    {
+        const auto found = std::find (waitingListeners.begin(), waitingListeners.end(), &listener);
+
+        if (waiting && found == waitingListeners.end())
+            waitingListeners.push_back (&listener);
+        else if (! waiting && found != waitingListeners.end())
