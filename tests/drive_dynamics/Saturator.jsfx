desc: Saturator (Live-style waveshaping saturation)
author: Alessio Scala
version: 1.0
about:
  A recreation of the Saturator audio effect found in Ableton Live, modelled
  from measurements of the original device (not from its code).
  Eight curves (Analog Clip, Soft Sine, Bass Shaper, Medium Curve, Hard Curve,
  Sinoid Fold, Digital Clip, Waveshaper), Color pre/post EQ, Post Clip, Output,
  Dry/Wet, Pre-DC filter and 2x Hi-Quality oversampling.
  Drag knobs vertically (Shift = fine), double-click to reset, click the curve
  type or Post Clip boxes for a menu.

slider1:drive=0<-36,36,0.01>-Drive (dB)
slider2:ctype=0<0,7,1{Analog Clip,Soft Sine,Bass Shaper,Medium Curve,Hard Curve,Sinoid Fold,Digital Clip,Waveshaper}>-Type
slider3:color=0<0,1,1{Off,On}>-Color
slider4:amtlo=0<-36,36,0.01>-Amt Lo (dB)
slider5:cfreq=1000<30,18500,1:log=1000>-Frequency (Hz)
slider6:cwidth=30<0,100,0.1>-Width (%)
slider7:amthi=0<-24,24,0.01>-Amt Hi (dB)
slider8:postclip=0<0,2,1{Off,Soft Clip,Hard Clip}>-Post Clip
slider9:outdb=0<-36,0,0.01>-Output (dB)
slider10:drywet=100<0,100,0.1>-Dry/Wet (%)
slider11:bthr=-50<-50,0,0.01>-Bass Shaper Threshold (dB)
slider12:wsdrive=100<0,100,0.1>-WS Drive (%)
slider13:wslin=50<0,100,0.1>-WS Linear (%)
slider14:wscurve=0<0,100,0.1>-WS Curve (%)
slider15:wsdamp=0<0,100,0.1>-WS Damp (%)
slider16:wsperiod=0<0,100,0.1>-WS Period (%)
slider17:wsdepth=0<0,100,0.1>-WS Depth (%)
slider18:dcfilt=0<0,1,1{Off,On}>-Pre-DC Filter
slider19:hiq=1<0,1,1{Off,On}>-Hi-Quality

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// ---------------- measured constants ----------------
SHELF_FC = 405.4785; SHELF_K = -0.465936; SHELF_FDC = 2.715171;   // Amt Lo shelf
BELL_Q0 = 1.71109; BELL_Q1 = 0.3008; BELL_QE = 2.22389;   // Width 0..1 -> bell Q
DC_FC = 27.33; DC_Q = 0.486;                   // Pre-DC filter (2nd-order high-pass)
WSDC_FC = 7.022;                               // Waveshaper output DC blockers (2 stages)
WS_DAMP_K = 0.00624; WS_PERIOD_K = 60; WS_CLAMP = 10;
UMAX_A = 8; UMAX_M = 4; UMAX_H = 16; LUTN = 128;

// memory layout
LUT_A = 0; LUT_M = 200; LUT_H = 400; HB = 600; ST = 1000; DRYL = 3000; DRYR = 4100;
// measured curve tables (cubic Hermite knots, evenly spaced in sqrt(|u| / umax))
