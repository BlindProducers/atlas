TAB_C[845]=8.05621; TAB_C[846]=8.06965; TAB_C[847]=8.08309; TAB_C[848]=8.09653; TAB_C[849]=8.10997; TAB_C[850]=8.11905; TAB_C[851]=8.13373; TAB_C[852]=8.14891;
TAB_C[853]=8.16006; TAB_C[854]=8.17073; TAB_C[855]=8.1814; TAB_C[856]=8.19408; TAB_C[857]=8.2069; TAB_C[858]=8.21972; TAB_C[859]=8.23254; TAB_C[860]=8.24536;
TAB_C[861]=8.25857; TAB_C[862]=8.2718; TAB_C[863]=8.28503; TAB_C[864]=8.29907; TAB_C[865]=8.30684; TAB_C[866]=8.32099; TAB_C[867]=8.33514; TAB_C[868]=8.34929;
TAB_C[869]=8.35812; TAB_C[870]=8.37136; TAB_C[871]=8.38758; TAB_C[872]=8.40379; TAB_C[873]=8.42001; TAB_C[874]=8.43668; TAB_C[875]=8.45955; TAB_C[876]=8.48209;
TAB_C[877]=8.50258; TAB_C[878]=8.52194; TAB_C[879]=8.54373; TAB_C[880]=8.56778; TAB_C[881]=8.59183; TAB_C[882]=8.61588; TAB_C[883]=8.6424; TAB_C[884]=8.67151;
TAB_C[885]=8.69743; TAB_C[886]=8.72335; TAB_C[887]=8.7426; TAB_C[888]=8.76872; TAB_C[889]=8.79484; TAB_C[890]=8.82095; TAB_C[891]=8.84707; TAB_C[892]=8.87404;
TAB_C[893]=8.89791; TAB_C[894]=8.92178; TAB_C[895]=8.94576; TAB_C[896]=8.97092; TAB_C[897]=8.99608; TAB_C[898]=9.02125; TAB_C[899]=9.03938; TAB_C[900]=9.06092;
TAB_C[901]=9.08246; TAB_C[902]=9.104; TAB_C[903]=9.1251; TAB_C[904]=9.14578; TAB_C[905]=9.16646; TAB_C[906]=9.18458; TAB_C[907]=9.20226; TAB_C[908]=9.22272;
TAB_C[909]=9.23435; TAB_C[910]=9.24694; TAB_C[911]=9.26079; TAB_C[912]=9.27464; TAB_C[913]=9.29038; TAB_C[914]=9.30359; TAB_C[915]=9.31289; TAB_C[916]=9.3222;
TAB_C[917]=9.33131; TAB_C[918]=9.34038; TAB_C[919]=9.34946; TAB_C[920]=9.36012; TAB_C[921]=9.36515; TAB_C[922]=9.36849; TAB_C[923]=9.37239; TAB_C[924]=9.3765;
TAB_C[925]=9.3806; TAB_C[926]=9.38552; TAB_C[927]=9.39058; TAB_C[928]=9.388; TAB_C[929]=9.39357; TAB_C[930]=9.39256; TAB_C[931]=9.38992; TAB_C[932]=9.39137;
TAB_C[933]=9.388; TAB_C[934]=9.39154; TAB_C[935]=9.38628; TAB_C[936]=9.38284; TAB_C[937]=9.38068; TAB_C[938]=9.37839; TAB_C[939]=9.37588; TAB_C[940]=9.37467;
TAB_C[941]=9.37463; TAB_C[942]=9.36826; TAB_C[943]=9.36586; TAB_C[944]=9.36362; TAB_C[945]=9.36161; TAB_C[946]=9.36306; TAB_C[947]=9.35921; TAB_C[948]=9.35983;
TAB_C[949]=9.35745; TAB_C[950]=9.35761; TAB_C[951]=9.3585; TAB_C[952]=9.3575; TAB_C[953]=9.35739; TAB_C[954]=9.35875; TAB_C[955]=9.35739; TAB_C[956]=9.35739;
TAB_C[957]=9.35837;
// 2x polyphase IIR half-band used by Hi-Quality (coefficients alternate between the two branches)
HB_PER = 3; HB_LAT = 4;
HB[0] = 0.0178514446; HB[1] = 0.1322267046; HB[2] = 0.3768012742; HB[3] = 0.6375699163; HB[4] = 0.8740288713; HB[5] = 0.9955406713;
memset(ST, 0, 900);
memset(DRYL, 0, 2200);
dwp = 0;

// measured tube curve: Catmull-Rom spline through evenly spaced knots, flat outside
function tcurve(tab, u) local(p, i, f, p0, p1, p2, p3, m1, m2, f2, f3) (
  p = (min(max(u, LUT_U0), LUT_U1) - LUT_U0) * LUT_SCALE;
  i = min(floor(p), LUT_K - 1); f = p - i;
  p0 = tab[i]; p1 = tab[i + 1]; p2 = tab[i + 2]; p3 = tab[i + 3];
  m1 = 0.5 * (p2 - p0); m2 = 0.5 * (p3 - p1);
  f2 = f * f; f3 = f2 * f;
  (2 * f3 - 3 * f2 + 1) * p1 + (f3 - 2 * f2 + f) * m1 + (-2 * f3 + 3 * f2) * p2 + (f3 - f2) * m2;
);
function tshape(u) ( tcurve(cur_tab, u); );

// generic biquad (TDF-II); coefficients live in the namespace given as c*
function bq(x, c*) local(y) (
  y = c.b0 * x + this.s1;
  this.s1 = c.b1 * x - c.a1 * y + this.s2;
  this.s2 = c.b2 * x - c.a2 * y;
  y;
);
function set_norm(b0, b1, b2, a0, a1, a2) (
  this.b0 = b0 / a0; this.b1 = b1 / a0; this.b2 = b2 / a0; this.a1 = a1 / a0; this.a2 = a2 / a0;
);
// inverse of a biquad (swap numerator and denominator)
function set_inverse(c*) (
  this.set_norm(1, c.a1, c.a2, c.b0, c.b1, c.b2);
);
// RBJ shelving filter; hi = 0 low shelf, hi = 1 high shelf
function set_shelf(hi, fc, gdb, s) local(amp, w0, cs, al, sq) (
  amp = 10 ^ (gdb / 40); w0 = 2 * $pi * min(fc, 0.49 * srate) / srate; cs = cos(w0);
  al = sin(w0) / 2 * sqrt((amp + 1 / amp) * (1 / s - 1) + 2); sq = 2 * sqrt(amp) * al;
  hi ? this.set_norm(amp * ((amp + 1) + (amp - 1) * cs + sq), -2 * amp * ((amp - 1) + (amp + 1) * cs), amp * ((amp + 1) + (amp - 1) * cs - sq),
                     (amp + 1) - (amp - 1) * cs + sq, 2 * ((amp - 1) - (amp + 1) * cs), (amp + 1) - (amp - 1) * cs - sq)
     : this.set_norm(amp * ((amp + 1) - (amp - 1) * cs + sq), 2 * amp * ((amp - 1) - (amp + 1) * cs), amp * ((amp + 1) - (amp - 1) * cs - sq),
                     (amp + 1) + (amp - 1) * cs + sq, -2 * ((amp - 1) + (amp + 1) * cs), (amp + 1) + (amp - 1) * cs - sq);
);
function dcb(x) local(y) (
  y = dc_b * (x - this.x1) - dc_a * this.y1;
  this.x1 = x; this.y1 = y;
  y;
);

// allpass chain over coefficients HB[first], HB[first+2], ...; sb = state base
function ap_chain(x, first, sb) local(i, c, y) (
  i = 0;
  loop(HB_PER,
    c = HB[first + 2 * i];
    y = c * (x - sb[2 * i + 1]) + sb[2 * i];
    sb[2 * i] = x; sb[2 * i + 1] = y; x = y;
    i += 1;
  );
  x;
);
// one host-rate sample through the 2x oversampled tube (offset b added after upsampling)
function shape_os(u, b, base) local(a, c, y) (
  a = ap_chain(tshape(ap_chain(u, 0, base) + b), 0, base + 128);
  c = ap_chain(tshape(ap_chain(u, 1, base + 64) + b), 1, base + 192);
  y = 0.5 * (a + base[300]); base[300] = c;
  y;
);

k = tan($pi * DC_FC / srate); dc_b = 1 / (1 + k); dc_a = (k - 1) / (k + 1);
sm = 1 - exp(-1 / (0.02 * srate));
sm_init = 0;
last_tone = -100;
envl = envr = 0;

function ms_coef(ms) ( 1 - exp(-1 / (max(ms, 0.001) * 0.001 * srate)); );

function update_targets() (
  t_gain = 10 ^ (drive / 20);
  t_out = 10 ^ (outdb / 20);
  t_mix = drywet / 100;
  t_bias = BIAS_K * bias / 100;
  t_env = envamt;
  att_c = ms_coef(attack); rel_c = ms_coef(release);
  ttype_i = min(max(floor(ttype + 0.5), 0), 2);
  cur_tab = ttype_i == 0 ? TAB_A : ttype_i == 1 ? TAB_B : TAB_C;
  use_tone = abs(tone) > 0.00001;
  tone != last_tone ? (
    last_tone = tone;
    tlo.set_shelf(0, TONE_LO_FC, TONE_DB * tone, TONE_S); tloi.set_inverse(tlo);
    thi.set_shelf(1, TONE_HI_FC, -TONE_DB * tone, TONE_S); thii.set_inverse(thi);
  );
  os_on = hiq >= 0.5;
  lat = os_on ? HB_LAT : 0;
  pdc_delay = lat; pdc_bot_ch = 0; pdc_top_ch = 2;
);

@slider
update_targets();
!sm_init ? (sm_init = 1; s_gain = t_gain; s_out = t_out; s_mix = t_mix; s_bias = t_bias; s_env = t_env);

@block
// parameter changes made in the UI are applied here, on the audio thread
ui_dirty ? (ui_dirty = 0; update_targets());
mon_env = max(mon_envl, mon_envr); mon_envl = mon_envr = 0;

@sample
s_gain += sm * (t_gain - s_gain);
s_out  += sm * (t_out - s_out);
s_mix  += sm * (t_mix - s_mix);
s_bias += sm * (t_bias - s_bias);
s_env  += sm * (t_env - s_env);

xl = spl0; xr = spl1;
use_tone ? (xl = thl.bq(tll.bq(xl, tlo), thi); xr = thr.bq(tlr.bq(xr, tlo), thi));
// envelope follower on the (tone-shaped) input moves the bias
vl = abs(xl); envl += (vl > envl ? att_c : rel_c) * (vl - envl);
vr = abs(xr); envr += (vr > envr ? att_c : rel_c) * (vr - envr);
bl = -s_bias - s_env * envl; br = -s_bias - s_env * envr;   // curve offset (Envelope is not scaled by Drive)
mon_envl = max(mon_envl, envl); mon_envr = max(mon_envr, envr);
os_on ? (
  yl = shape_os(s_gain * xl, bl, ST);
  yr = shape_os(s_gain * xr, br, ST + 400);
) : (
  yl = tshape(s_gain * xl + bl);
  yr = tshape(s_gain * xr + br);
);
yl /= s_gain; yr /= s_gain;
use_tone ? (yl = thli.bq(tlli.bq(yl, tloi), thii); yr = thri.bq(tlri.bq(yr, tloi), thii));
yl = dl2.dcb(dl1.dcb(yl)); yr = dr2.dcb(dr1.dcb(yr));
yl *= s_out; yr *= s_out;

// dry path delayed to match the oversampling latency
DRYL[dwp] = spl0; DRYR[dwp] = spl1;
rp = (dwp - lat + 1024) % 1024;
dwp = (dwp + 1) % 1024;
spl0 = (1 - s_mix) * DRYL[rp] + s_mix * yl;
spl1 = (1 - s_mix) * DRYR[rp] + s_mix * yr;

@gfx 600 260
// ---------------- UI ----------------
function rgb(r, g, b) ( gfx_r = r / 255; gfx_g = g / 255; gfx_b = b / 255; gfx_a = 1; );
function clamp(v, lo, hi) ( min(max(v, lo), hi); );
function inr(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );
function txt(x, y, w, h, s, flags) ( gfx_x = x; gfx_y = y; gfx_drawstr(s, flags, x + w, y + h); );

// Private copy of the curve function for drawing. JSFX function parameters and
// locals are shared statics, so the UI thread must never call the functions the
// audio thread is running (it would overwrite their values mid-sample).
function g_tcurve(tab, u) local(p, i, f, p0, p1, p2, p3, m1, m2, f2, f3) (
  p = (min(max(u, LUT_U0), LUT_U1) - LUT_U0) * LUT_SCALE;
  i = min(floor(p), LUT_K - 1); f = p - i;
  p0 = tab[i]; p1 = tab[i + 1]; p2 = tab[i + 2]; p3 = tab[i + 3];
  m1 = 0.5 * (p2 - p0); m2 = 0.5 * (p3 - p1);
  f2 = f * f; f3 = f2 * f;
  (2 * f3 - 3 * f2 + 1) * p1 + (f3 - 2 * f2 + f) * m1 + (-2 * f3 + 3 * f2) * p2 + (f3 - f2) * m2;
);

// parameter table: id -> slider value access
function pget(id) (
  id == 1 ? drive : id == 3 ? bias : id == 4 ? envamt : id == 5 ? attack : id == 6 ? release :
  id == 7 ? tone : id == 8 ? outdb : drywet;
);
function pset(id, v) (
  id == 1 ? (drive = clamp(v, -15, 15); slider_automate(drive));
  id == 2 ? (ttype = clamp(floor(v + 0.5), 0, 2); slider_automate(ttype));
  id == 3 ? (bias = clamp(v, 0, 100); slider_automate(bias));
  id == 4 ? (envamt = clamp(v, -3, 3); slider_automate(envamt));
  id == 5 ? (attack = clamp(v, 1, 400); slider_automate(attack));
  id == 6 ? (release = clamp(v, 1, 1500); slider_automate(release));
  id == 7 ? (tone = clamp(v, -1, 1); slider_automate(tone));
  id == 8 ? (outdb = clamp(v, -15, 15); slider_automate(outdb));
  id == 9 ? (drywet = clamp(v, 0, 100); slider_automate(drywet));
  id == 10 ? (hiq = clamp(v, 0, 1); slider_automate(hiq));
  ui_dirty = 1;   // applied by the audio thread in @block
);
// knob ranges and defaults
function pmin(id) ( id == 1 || id == 8 ? -15 : id == 4 ? -3 : id == 5 || id == 6 ? 1 : id == 7 ? -1 : 0; );
function pmax(id) ( id == 1 || id == 8 ? 15 : id == 4 ? 3 : id == 5 ? 400 : id == 6 ? 1500 : id == 7 ? 1 : 100; );
function pdef(id) ( id == 5 ? DEF_ATT : id == 6 ? DEF_REL : id == 9 ? 100 : 0; );
function plog(id) ( id == 5 || id == 6; );
function pnorm(id, v) ( plog(id) ? log(v / pmin(id)) / log(pmax(id) / pmin(id)) : (v - pmin(id)) / (pmax(id) - pmin(id)); );
function pdenorm(id, n) ( n = clamp(n, 0, 1); plog(id) ? pmin(id) * (pmax(id) / pmin(id)) ^ n : pmin(id) + n * (pmax(id) - pmin(id)); );
function pfmt(id, v) (
  id == 1 || id == 8 ? sprintf(#pf, "%.2f dB", v) :
  id == 4 || id == 7 ? sprintf(#pf, "%.2f", v) :
  id == 5 || id == 6 ? (v < 10 ? sprintf(#pf, "%.2f ms", v) : v < 100 ? sprintf(#pf, "%.1f ms", v) : sprintf(#pf, "%.0f ms", v)) :
  sprintf(#pf, "%.0f %%", v);
  #pf;
);

// knob registry for hit-testing this frame
nk = 0;
function knob(id, cx, cy, r, label) local(a0, a1, a, a_z, i, n, v) (
  v = pget(id); n = pnorm(id, v);
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; a = a0 + (a1 - a0) * n;
  // bipolar knobs draw their arc from the centre
  a_z = (id == 1 || id == 4 || id == 7 || id == 8) ? 0 : a0;
  rgb(65, 65, 65); gfx_circle(cx, cy, r, 1, 1);
  rgb(36, 36, 36); gfx_circle(cx, cy, r - 3, 1, 1);
  rgb(255, 170, 40); i = 0; loop(3, gfx_arc(cx, cy, r + 1 + i * 0.7, min(a_z, a), max(a_z, a), 1); i += 1);
  rgb(235, 235, 235); gfx_line(cx + sin(a) * (r - 9), cy - cos(a) * (r - 9), cx + sin(a) * (r - 2), cy - cos(a) * (r - 2), 1);
  gfx_setfont(2); rgb(200, 200, 200);
  txt(cx - 45, cy - r - 17 * ui_s, 90, 14 * ui_s, label, 1);
  rgb(230, 230, 230); txt(cx - 45, cy + r + 3, 90, 14 * ui_s, pfmt(id, v), 1);
  KNOB_X[nk] = cx; KNOB_Y[nk] = cy; KNOB_R[nk] = r; KNOB_ID[nk] = id; nk += 1;
);
function button(x, y, w, h, s, on) (
  on ? rgb(255, 170, 40) : rgb(60, 60, 60); gfx_rect(x, y, w, h);
  on ? rgb(20, 20, 20) : rgb(220, 220, 220);
  gfx_setfont(2); txt(x, y, w, h, s, 5);
);

// knob hit-test arrays (EEL2 names are case-insensitive, so these must not
// reuse any other variable name)
KNOB_X = 8000; KNOB_Y = 8100; KNOB_R = 8200; KNOB_ID = 8300;
// display values computed here from the sliders (the audio thread keeps its own)
d_gain = 10 ^ (drive / 20); d_out = 10 ^ (outdb / 20); d_mix = drywet / 100;
d_type = clamp(floor(ttype + 0.5), 0, 2);
d_tab = d_type == 0 ? TAB_A : d_type == 1 ? TAB_B : TAB_C;
d_beta = -BIAS_K * bias / 100;
ui_s = max(0.7, min(gfx_w / 600, gfx_h / 260));
gfx_setfont(1, "Arial", 13 * ui_s);
gfx_setfont(2, "Arial", 11 * ui_s);
rgb(30, 30, 30); gfx_rect(0, 0, gfx_w, gfx_h);
pad = 10 * ui_s;

// ---- left: Drive and tube type ----
lw = 110 * ui_s;
knob(1, pad + lw / 2, pad + 48 * ui_s, 26 * ui_s, "Drive");
bw = (lw - 8 * ui_s) / 3; by_ = pad + 104 * ui_s; bh = 22 * ui_s;
button(pad, by_, bw, bh, "A", d_type == 0);
button(pad + bw + 4 * ui_s, by_, bw, bh, "B", d_type == 1);
button(pad + 2 * (bw + 4 * ui_s), by_, bw, bh, "C", d_type == 2);
gfx_setfont(2); rgb(160, 160, 160); txt(pad, by_ + bh + 2 * ui_s, lw, 14 * ui_s, "Tube", 1);
hq_y = by_ + bh + 22 * ui_s;
button(pad, hq_y, lw, bh, "Hi-Q", hiq >= 0.5);

// ---- middle: transfer display with the bias operating point ----
dx = pad + lw + 14 * ui_s; dy = pad; dw = 200 * ui_s; dh = 150 * ui_s;
rgb(18, 18, 18); gfx_rect(dx, dy, dw, dh);
rgb(50, 50, 50); gfx_line(dx, dy + dh / 2, dx + dw, dy + dh / 2); gfx_line(dx + dw / 2, dy, dx + dw / 2, dy + dh);
// output vs input (-1..1), DC removed as the device's DC blockers do, then Output and Dry/Wet
y0_ = g_tcurve(d_tab, d_beta);
i = 0;
rgb(255, 170, 40);
loop(dw + 1,
  xin = (i / dw) * 2 - 1;
  yv = (g_tcurve(d_tab, d_gain * xin + d_beta) - y0_) / d_gain * d_out;
  yv = (1 - d_mix) * xin + d_mix * yv;
  py = dy + dh / 2 - clamp(yv / 1.2, -1, 1) * dh / 2;
  i > 0 ? gfx_lineto(dx + i, py, 1) : (gfx_x = dx; gfx_y = py);
  i += 1;
);
// envelope activity: how far the envelope currently moves the bias
mon_b = clamp(-envamt * mon_env, -3, 3);
rgb(120, 200, 255);
gfx_rect(dx + dw / 2 + min(0, mon_b) * dw / 6, dy + dh - 5 * ui_s, max(1, abs(mon_b) * dw / 6), 4 * ui_s);
gfx_setfont(2); rgb(130, 130, 130);
txt(dx + 4 * ui_s, dy + 3 * ui_s, dw, 14 * ui_s, d_type == 0 ? "Tube A" : d_type == 1 ? "Tube B" : "Tube C", 0);

// knobs under the display: Bias / Envelope / Attack / Release
kr_ = 16 * ui_s; ky_ = dy + dh + 50 * ui_s;
knob(3, dx + dw * 0.125, ky_, kr_, "Bias");
knob(4, dx + dw * 0.375, ky_, kr_, "Envelope");
knob(5, dx + dw * 0.625, ky_, kr_, "Attack");
knob(6, dx + dw * 0.875, ky_, kr_, "Release");

// ---- right: Tone, Output, Dry/Wet ----
rx = dx + dw + 14 * ui_s; rw = gfx_w - rx - pad;
knob(7, rx + rw * 0.5, pad + 48 * ui_s, 22 * ui_s, "Tone");
knob(8, rx + rw * 0.27, ky_ - 50 * ui_s, 18 * ui_s, "Output");
knob(9, rx + rw * 0.73, ky_ - 50 * ui_s, 18 * ui_s, "Dry/Wet");

// ---- mouse ----
fine = (mouse_cap & 8) ? 0.1 : 1;
clicked = (mouse_cap & 1) && !(last_cap & 1);
clicked ? (
  dbl = (time_precise() - last_t) < 0.3; last_t = time_precise();
  drag = 0; i = 0;
  loop(nk, (mouse_x - KNOB_X[i]) ^ 2 + (mouse_y - KNOB_Y[i]) ^ 2 <= (KNOB_R[i] + 4) ^ 2 ? (drag = KNOB_ID[i]); i += 1);
  drag ? (
    dbl ? (pset(drag, pdef(drag)); drag = 0);
    dragn = pnorm(drag, pget(drag)); lmy = mouse_y;
  ) : (
    inr(pad, by_, bw, bh) ? pset(2, 0) :
    inr(pad + bw + 4 * ui_s, by_, bw, bh) ? pset(2, 1) :
    inr(pad + 2 * (bw + 4 * ui_s), by_, bw, bh) ? pset(2, 2) :
    inr(pad, hq_y, lw, bh) ? pset(10, hiq >= 0.5 ? 0 : 1);
  );
);
(mouse_cap & 1) && drag ? (
  dragn = clamp(dragn - (mouse_y - lmy) * 0.005 * fine, 0, 1); lmy = mouse_y;
  pset(drag, pdenorm(drag, dragn));
);
!(mouse_cap & 1) ? (drag = 0);
last_cap = mouse_cap;
mouse_wheel != 0 ? (
  i = 0;
  loop(nk,
    (mouse_x - KNOB_X[i]) ^ 2 + (mouse_y - KNOB_Y[i]) ^ 2 <= (KNOB_R[i] + 4) ^ 2 ? (
      pset(KNOB_ID[i], pdenorm(KNOB_ID[i], pnorm(KNOB_ID[i], pget(KNOB_ID[i])) + mouse_wheel / 120 * 0.01 * fine));
    );
    i += 1;
  );
  mouse_wheel = 0;
);

