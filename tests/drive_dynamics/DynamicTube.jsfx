desc: Dynamic Tube (Live-style tube saturation)
author: Alessio Scala
version: 1.0
about:
  A recreation of the Dynamic Tube audio effect found in Ableton Live, modelled
  from measurements of the original device (not from its code).
  Three tube curves (A, B, C), Drive, Bias with an envelope follower
  (Envelope, Attack, Release), Tone, Output, Dry/Wet and 2x Hi-Quality
  oversampling.
  Drag knobs vertically (Shift = fine), double-click to reset, click A / B / C
  and Hi-Q to switch.

slider1:drive=0<-15,15,0.01>-Drive (dB)
slider2:ttype=0<0,2,1{A,B,C}>-Tube Type
slider3:bias=0<0,100,0.1>-Bias (%)
slider4:envamt=0<-3,3,0.01>-Envelope
slider5:attack=5<1,400,0.1:log=20>-Attack (ms)
slider6:release=35<1,1500,0.1:log=40>-Release (ms)
slider7:tone=0<-1,1,0.001>-Tone
slider8:outdb=0<-15,15,0.01>-Output (dB)
slider9:drywet=100<0,100,0.1>-Dry/Wet (%)
slider10:hiq=0<0,1,1{Off,On}>-Hi-Quality

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// ---------------- measured constants ----------------
BIAS_K = 1.3;                         // curve offset per unit of Bias
TONE_LO_FC = 40; TONE_HI_FC = 18500;  // Tone: tilting shelves (+/-15 dB at Tone = +/-1), slope 0.1
TONE_DB = 15; TONE_S = 0.1;
DC_FC = 7.022;                        // two 1st-order DC blockers after the tube
LUT_U0 = -2.5; LUT_U1 = 10.5; LUT_K = 1040; LUT_SCALE = LUT_K / (LUT_U1 - LUT_U0);
DEF_ATT = 5.0; DEF_REL = 35.0;

// memory layout
TAB_A = 0; TAB_B = 1100; TAB_C = 2200; HB = 3300; ST = 3400; DRYL = 4300; DRYR = 5400;
// measured tube curves (Catmull-Rom knots, evenly spaced over u0..u1)
lut_i = 0; loop(144, TAB_A[lut_i] = -0.651714; lut_i += 1);
lut_i = 1015; loop(28, TAB_A[lut_i] = 9.358724; lut_i += 1);
