desc:Serum Reverb Filter - Reference Fit
//tags: filter reverb allpass diffusion resonator
//author: OpenAI Codex, fitted from user-supplied Serum 2 recordings
//version: 1.1.0

slider1:cutoff_hz=100<8,20000,1:log=400>Cutoff (Hz)
slider2:resonance_pct=0<0,100,0.1>Resonance (%)
slider3:damp_pct=0<0,100,0.1>Damp (%)
slider4:mix_pct=100<0,100,0.1>Mix (%)
slider5:output_db=0<-24,12,0.1>Output (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

/*
  Reference-fit notes
  -------------------
  The supplied captures show a wet-only, mono-compatible phase-smearing
  network rather than a normal low-pass filter.  Its delay pattern scales
  approximately as 1 / cutoff.  Resonance changes the recirculation decay
  while leaving the first reflection pattern nearly unchanged.

  At 44.1 kHz, the measured response is well described by:
    - first arrival: about 0.81 / cutoff seconds from 50 to 400 Hz
    - strongest early energy: about 2.0 to 2.4 / cutoff seconds
    - decay slopes: -11, -5.5 and about -0.08 dB per normalized time unit
      at 0%, 50% and 100% resonance respectively

  This implementation uses a modulated 16-line Householder FDN surrounded
  by three input and three output all-pass diffusers.  A short measured
  correction layer restores Serum's denser high-cutoff response, where a
  pure sample-rounded delay network loses too many distinct paths.  Both
  channels use identical coefficients, so mono input remains perfectly
  mono, matching the captures.  Stereo input is processed dual-mono.
*/

@init

ext_tail_size = -1;

NUM_LINES = 16;
NUM_AP = 6;
LOW_TAPS = 32;
FIR_SIZE = 384;
FIR800_SIZE = 320;
FIR1600_SIZE = 192;
HIGH_FIR_SIZE = 128;
MIN_CUTOFF = 8;
MAX_MAIN_RATIO = 1.36;
MAX_AP_RATIO = 0.42;
MAX_LOW_RATIO = 0.55;
INV_SQRT_LINES = 0.25;
FDN_OUTPUT_GAIN = 2.2844642888941586 * INV_SQRT_LINES;
DB_TO_LOG = 0.11512925464970229; // ln(10) / 20
TWO_PI = 6.283185307179586;

// Small control arrays live below the audio-buffer region.
ratio_mem = 0;
input_sign_mem = 32;
output_sign_mem = 64;
gain_mem = 96;
gain_target_mem = 128;
gain_delta_mem = 160;
read_l_mem = 192;
read_r_mem = 224;
damp_l_mem = 256;
damp_r_mem = 288;
low_ratio_mem = 320;
low_coeff_mem = 352;

// Reference-residual FIR layout.  Longer kernels are retained where Serum's
// response is most diffuse; 3200 Hz and above need only 128 samples.
fir400_mem = 512;
fir800_mem = 896;
fir1600_mem = 1216;
fir3200_mem = 1408;
fir6400_mem = 1536;
fir12800_mem = 1664;
fir_history_l = 2048;
fir_history_r = 2432;

