fir12800_mem[88] = -0.000125490992;
fir12800_mem[89] = +0.000147193723;
fir12800_mem[90] = -0.000189977606;
fir12800_mem[91] = +0.000219717043;
fir12800_mem[92] = -0.000249654657;
fir12800_mem[93] = +0.000275486185;
fir12800_mem[94] = -0.000309107678;
fir12800_mem[95] = +0.000325106129;
fir12800_mem[96] = -0.000349848460;
fir12800_mem[97] = +0.000367760261;
fir12800_mem[98] = -0.000385877221;
fir12800_mem[99] = +0.000391408677;
fir12800_mem[100] = -0.000407291277;
fir12800_mem[101] = +0.000414628883;
fir12800_mem[102] = -0.000424292605;
fir12800_mem[103] = +0.000426777183;
fir12800_mem[104] = -0.000437786459;
fir12800_mem[105] = +0.000435405306;
fir12800_mem[106] = -0.000440258606;
fir12800_mem[107] = +0.000435730461;
fir12800_mem[108] = -0.000431089771;
fir12800_mem[109] = +0.000418088567;
fir12800_mem[110] = -0.000417980045;
fir12800_mem[111] = +0.000405920599;
fir12800_mem[112] = -0.000400907368;
fir12800_mem[113] = +0.000394297876;
fir12800_mem[114] = -0.000391266934;
fir12800_mem[115] = +0.000377163252;
fir12800_mem[116] = -0.000371511275;
fir12800_mem[117] = +0.000360028453;
fir12800_mem[118] = -0.000356448012;
fir12800_mem[119] = +0.000342483877;
fir12800_mem[120] = -0.000332562874;
fir12800_mem[121] = +0.000320477960;
fir12800_mem[122] = -0.000314762692;
fir12800_mem[123] = +0.000293998854;
fir12800_mem[124] = -0.000279938718;
fir12800_mem[125] = +0.000270403152;
fir12800_mem[126] = -0.000259788029;
fir12800_mem[127] = +0.000217302550;

input_sign_mem[0]  = -1;
input_sign_mem[1]  =  1;
input_sign_mem[2]  = -1;
input_sign_mem[3]  = -1;
input_sign_mem[4]  =  1;
input_sign_mem[5]  = -1;
input_sign_mem[6]  =  1;
input_sign_mem[7]  =  1;
input_sign_mem[8]  = -1;
input_sign_mem[9]  =  1;
input_sign_mem[10] = -1;
input_sign_mem[11] = -1;
input_sign_mem[12] =  1;
input_sign_mem[13] = -1;
input_sign_mem[14] =  1;
input_sign_mem[15] =  1;

i = 0;
loop(NUM_LINES,
  output_sign_mem[i] = i < 8 ? -1 : 1;
  i += 1;
);

main_size = ceil(srate * MAX_MAIN_RATIO / MIN_CUTOFF) + 4;
ap_size = ceil(srate * MAX_AP_RATIO / MIN_CUTOFF) + 4;
low_size = ceil(srate * MAX_LOW_RATIO / MIN_CUTOFF) + 4;

line_l_base = 4096;
line_r_base = line_l_base + NUM_LINES * main_size;
ap_l_base = line_r_base + NUM_LINES * main_size;
ap_r_base = ap_l_base + NUM_AP * ap_size;
low_l_base = ap_r_base + NUM_AP * ap_size;
low_r_base = low_l_base + low_size;
buffer_end = low_r_base + low_size;
freembuf(buffer_end);

fdn_pos = 0;
ap_pos = 0;
low_pos = 0;
fir_pos = 0;

LOG_8 = log(8);
LOG_50 = log(50);
LOG_200 = log(200);
LOG_300 = log(300);
LOG_400 = log(400);
LOG_800 = log(800);
LOG_1600 = log(1600);
LOG_3200 = log(3200);
LOG_6400 = log(6400);
LOG_12800 = log(12800);
LOG_NET_8 = log(12.4);

cut_log_smooth = log(max(MIN_CUTOFF, min(20000, cutoff_hz)));
cut_log_target = cut_log_smooth;
mix_smooth = mix_target = mix_pct * 0.01;
output_smooth = output_target = exp(output_db / 8.68588963806504);
boost_smooth = boost_target = 1;
damp_smooth = damp_target = 1;

res01 = max(0, min(1, resonance_pct * 0.01));
decay_db = -11 + 10.92 * res01;
i = 0;
loop(NUM_LINES,
  gain_mem[i] = gain_target_mem[i] = exp(DB_TO_LOG * decay_db * ratio_mem[i]);
  i += 1;
);

function delay_read(base, write_pos, size, delay_samples)
  local(read_pos)
(
  // The captures land on discrete sample taps.  Nearest-sample delays also
  // preserve the all-pass magnitude and the reference's high-cutoff gain;
  // linear delay interpolation audibly over-damps broadband transients.
  delay_samples = floor(max(1, min(size - 2, delay_samples)) + 0.5);
  read_pos = write_pos - delay_samples;
  read_pos < 0 ? read_pos += size;
  base[read_pos];
);

function allpass_tick(input, base, write_pos, size, delay_samples, coefficient)
  local(delayed, output, stored)
(
  delayed = delay_read(base, write_pos, size, delay_samples);
  output = delayed - coefficient * input;
  stored = input + coefficient * output;
  abs(stored) < 0.00000000000000000001 ? stored = 0;
  base[write_pos] = stored;
  output;
);

function unit_lerp(x, x0, x1)
(
  max(0, min(1, (x - x0) / (x1 - x0)));
);

@slider

cut_log_target = log(max(MIN_CUTOFF, min(20000, cutoff_hz)));
mix_target = max(0, min(1, mix_pct * 0.01));
output_target = exp(output_db / 8.68588963806504);

res01 = max(0, min(1, resonance_pct * 0.01));
decay_db = -11 + 10.92 * res01;
boost_target = exp((2 * res01) / 8.68588963806504);

i = 0;
loop(NUM_LINES,
  gain_target_mem[i] = exp(DB_TO_LOG * decay_db * ratio_mem[i]);
  i += 1;
);

damp01 = max(0, min(1, damp_pct * 0.01));
damp01 <= 0.000001 ? (
  damp_target = 1;
) : (
  // The extra control mirrors Serum's DAMP/VAR concept.  Zero is the
  // undamped reference condition; 100% puts a roughly 500 Hz one-pole
  // low-pass in every feedback path.
  damp_hz = 20000 * exp(log(500 / 20000) * damp01);
  damp_target = min(1, 1 - exp(-TWO_PI * damp_hz / srate));
);

@block

block_samples = max(1, samplesblock);
cut_log_delta = (cut_log_target - cut_log_smooth) / block_samples;
mix_delta = (mix_target - mix_smooth) / block_samples;
output_delta = (output_target - output_smooth) / block_samples;
boost_delta = (boost_target - boost_smooth) / block_samples;
damp_delta = (damp_target - damp_smooth) / block_samples;

i = 0;
loop(NUM_LINES,
  gain_delta_mem[i] = (gain_target_mem[i] - gain_mem[i]) / block_samples;
  i += 1;
);

@sample

dry_l = spl0;
dry_r = spl1;

cut_log_smooth += cut_log_delta;
mix_smooth += mix_delta;
output_smooth += output_delta;
boost_smooth += boost_delta;
damp_smooth += damp_delta;

actual_cutoff = exp(cut_log_smooth);

// The 8 Hz capture contains a topology transition: its main cluster arrives
// earlier than a strict 1/cutoff extrapolation, while 50 Hz and above follow
// that law.  Interpolate the network rate only across this lowest interval.
cut_log_smooth < LOG_50 ? (
  low_network_t = unit_lerp(cut_log_smooth, LOG_8, LOG_50);
  network_log = LOG_NET_8 + low_network_t * (LOG_50 - LOG_NET_8);
) : (
  network_log = cut_log_smooth;
);
delay_scale = srate / exp(network_log);

// Input diffusion.  The short stages preserve phase-smearing density as
// cutoff moves upward and the main FDN delays approach single samples.
diff_l = dry_l;
diff_r = dry_r;

ap_delay = 0.023 * delay_scale;
diff_l = allpass_tick(diff_l, ap_l_base, ap_pos, ap_size, ap_delay, 0.82);
diff_r = allpass_tick(diff_r, ap_r_base, ap_pos, ap_size, ap_delay, 0.82);

ap_delay = 0.037 * delay_scale;
diff_l = allpass_tick(diff_l, ap_l_base + ap_size, ap_pos, ap_size, ap_delay, 0.82);
diff_r = allpass_tick(diff_r, ap_r_base + ap_size, ap_pos, ap_size, ap_delay, 0.82);

ap_delay = 0.053 * delay_scale;
diff_l = allpass_tick(diff_l, ap_l_base + 2 * ap_size, ap_pos, ap_size, ap_delay, 0.82);
diff_r = allpass_tick(diff_r, ap_r_base + 2 * ap_size, ap_pos, ap_size, ap_delay, 0.82);

sum_l = 0;
sum_r = 0;
wet_l = 0;
wet_r = 0;
i = 0;
loop(NUM_LINES,
  line_delay = ratio_mem[i] * delay_scale;
  line_base_l = line_l_base + i * main_size;
  line_base_r = line_r_base + i * main_size;
  value_l = delay_read(line_base_l, fdn_pos, main_size, line_delay);
  value_r = delay_read(line_base_r, fdn_pos, main_size, line_delay);
  read_l_mem[i] = value_l;
  read_r_mem[i] = value_r;

  // Damping is inside the recirculation path only; the early response is
  // unchanged, as in the reference filter family.
  lp_l = damp_l_mem[i] + damp_smooth * (value_l - damp_l_mem[i]);
  lp_r = damp_r_mem[i] + damp_smooth * (value_r - damp_r_mem[i]);
  damp_l_mem[i] = lp_l;
  damp_r_mem[i] = lp_r;
  sum_l += lp_l;
  sum_r += lp_r;

  wet_l += output_sign_mem[i] * value_l;
  wet_r += output_sign_mem[i] * value_r;
  i += 1;
);

// H = I - 2/N * 11' is an orthogonal Householder feedback matrix.
householder_l = 2 * sum_l / NUM_LINES;
householder_r = 2 * sum_r / NUM_LINES;

i = 0;
loop(NUM_LINES,
  gain_mem[i] += gain_delta_mem[i];
  feedback_l = damp_l_mem[i] - householder_l;
  feedback_r = damp_r_mem[i] - householder_r;
  stored_l = input_sign_mem[i] * diff_l * INV_SQRT_LINES + gain_mem[i] * feedback_l;
  stored_r = input_sign_mem[i] * diff_r * INV_SQRT_LINES + gain_mem[i] * feedback_r;
  abs(stored_l) < 0.00000000000000000001 ? stored_l = 0;
  abs(stored_r) < 0.00000000000000000001 ? stored_r = 0;
  (line_l_base + i * main_size)[fdn_pos] = stored_l;
  (line_r_base + i * main_size)[fdn_pos] = stored_r;
  i += 1;
);

wet_l *= FDN_OUTPUT_GAIN;
wet_r *= FDN_OUTPUT_GAIN;

// Output diffusion creates the measured slow energy build: a quiet first
// arrival near 0.81/cutoff, then the strongest cluster near 2/cutoff.
ap_delay = 0.23 * delay_scale;
wet_l = allpass_tick(wet_l, ap_l_base + 3 * ap_size, ap_pos, ap_size, ap_delay, 0.5);
wet_r = allpass_tick(wet_r, ap_r_base + 3 * ap_size, ap_pos, ap_size, ap_delay, 0.5);

ap_delay = 0.31 * delay_scale;
wet_l = allpass_tick(wet_l, ap_l_base + 4 * ap_size, ap_pos, ap_size, ap_delay, 0.5);
wet_r = allpass_tick(wet_r, ap_r_base + 4 * ap_size, ap_pos, ap_size, ap_delay, 0.5);

ap_delay = 0.41 * delay_scale;
wet_l = allpass_tick(wet_l, ap_l_base + 5 * ap_size, ap_pos, ap_size, ap_delay, 0.5);
wet_r = allpass_tick(wet_r, ap_r_base + 5 * ap_size, ap_pos, ap_size, ap_delay, 0.5);

// Measured early-response correction.  Interpolating adjacent residual
// kernels in log-frequency gives a considerably smoother sweep than changing
// a handful of one-to-four-sample delay taps abruptly.
fir_history_l[fir_pos] = dry_l;
fir_history_r[fir_pos] = dry_r;
fir_l = 0;
fir_r = 0;

cut_log_smooth > LOG_300 ? (
  cut_log_smooth < LOG_400 ? (
    fir_t = unit_lerp(cut_log_smooth, LOG_300, LOG_400);
    fir_a = fir400_mem;
    fir_b = fir400_mem;
    fir_count = FIR_SIZE;
    fir_a_count = FIR_SIZE;
    fir_b_count = FIR_SIZE;
    fir_scale = fir_t;
  ) : cut_log_smooth < LOG_800 ? (
    fir_t = unit_lerp(cut_log_smooth, LOG_400, LOG_800);
    fir_a = fir400_mem;
    fir_b = fir800_mem;
    fir_count = FIR_SIZE;
    fir_a_count = FIR_SIZE;
    fir_b_count = FIR800_SIZE;
    fir_scale = 1;
  ) : (
    cut_log_smooth < LOG_1600 ? (
      fir_t = unit_lerp(cut_log_smooth, LOG_800, LOG_1600);
      fir_a = fir800_mem; fir_b = fir1600_mem;
      fir_count = FIR800_SIZE;
      fir_a_count = FIR800_SIZE; fir_b_count = FIR1600_SIZE;
    ) : cut_log_smooth < LOG_3200 ? (
      fir_t = unit_lerp(cut_log_smooth, LOG_1600, LOG_3200);
      fir_a = fir1600_mem; fir_b = fir3200_mem;
      fir_count = FIR1600_SIZE;
      fir_a_count = FIR1600_SIZE; fir_b_count = HIGH_FIR_SIZE;
    ) : cut_log_smooth < LOG_6400 ? (
      fir_t = unit_lerp(cut_log_smooth, LOG_3200, LOG_6400);
      fir_a = fir3200_mem; fir_b = fir6400_mem;
      fir_count = HIGH_FIR_SIZE;
      fir_a_count = HIGH_FIR_SIZE; fir_b_count = HIGH_FIR_SIZE;
    ) : cut_log_smooth < LOG_12800 ? (
      fir_t = unit_lerp(cut_log_smooth, LOG_6400, LOG_12800);
      fir_a = fir6400_mem; fir_b = fir12800_mem;
      fir_count = HIGH_FIR_SIZE;
      fir_a_count = HIGH_FIR_SIZE; fir_b_count = HIGH_FIR_SIZE;
    ) : (
      fir_t = 0;
      fir_a = fir12800_mem; fir_b = fir12800_mem;
      fir_count = HIGH_FIR_SIZE;
      fir_a_count = HIGH_FIR_SIZE; fir_b_count = HIGH_FIR_SIZE;
    );
    fir_scale = 1;
  );

  i = 0;
  loop(fir_count,
    history_pos = fir_pos - i;
    history_pos < 0 ? history_pos += FIR_SIZE;
    i < fir_a_count ? fir_coefficient = fir_a[i] : fir_coefficient = 0;
    i < fir_b_count ? (
      fir_coefficient += fir_t * (fir_b[i] - fir_coefficient);
    ) : (
      fir_coefficient *= 1 - fir_t;
    );
    fir_coefficient *= fir_scale;
    fir_l += fir_coefficient * fir_history_l[history_pos];
    fir_r += fir_coefficient * fir_history_r[history_pos];
    i += 1;
  );
);

// Sparse bottom-range correction, faded completely out at 50 Hz.
low_l_base[low_pos] = dry_l;
low_r_base[low_pos] = dry_r;
low_amount = 1 - unit_lerp(cut_log_smooth, LOG_8, LOG_50);
low_l = 0;
low_r = 0;
low_amount > 0 ? (
  i = 0;
  loop(LOW_TAPS,
    low_delay = low_ratio_mem[i] * srate / actual_cutoff;
    low_l += low_coeff_mem[i] * delay_read(low_l_base, low_pos, low_size, low_delay);
    low_r += low_coeff_mem[i] * delay_read(low_r_base, low_pos, low_size, low_delay);
    i += 1;
  );
);

wet_l += fir_l + low_amount * low_l;
wet_r += fir_r + low_amount * low_r;

// Correct the small broadband energy deficit below 800 Hz.  Above 800 Hz
// the measured residual kernels already carry Serum's level exactly.
cut_log_smooth <= LOG_200 ? (
  cutoff_comp_db = 0.59;
) : cut_log_smooth < LOG_400 ? (
  cutoff_comp_db = 0.59 + unit_lerp(cut_log_smooth, LOG_200, LOG_400) * (0.14 - 0.59);
) : cut_log_smooth < LOG_800 ? (
  cutoff_comp_db = 0.14 * (1 - unit_lerp(cut_log_smooth, LOG_400, LOG_800));
) : (
  cutoff_comp_db = 0;
);
reference_gain = exp(cutoff_comp_db / 8.68588963806504) * boost_smooth;
wet_l *= reference_gain;
wet_r *= reference_gain;

spl0 = (dry_l * (1 - mix_smooth) + wet_l * mix_smooth) * output_smooth;
spl1 = (dry_r * (1 - mix_smooth) + wet_r * mix_smooth) * output_smooth;

(fdn_pos += 1) >= main_size ? fdn_pos = 0;
(ap_pos += 1) >= ap_size ? ap_pos = 0;
(low_pos += 1) >= low_size ? low_pos = 0;
(fir_pos += 1) >= FIR_SIZE ? fir_pos = 0;
