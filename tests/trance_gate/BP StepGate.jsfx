slider89:0<-1,1,0.01>Step 28 Value
slider90:0<0,5,1{Long,Medium,Short,Ramp Down (-inf),Ramp Up (0dB),Ramp Up 2 (+6dB)}>Step 28 Mode
slider91:0<-1,1,0.01>Step 28 Curve Adjust
slider92:0<-1,1,0.01>Step 29 Value
slider93:0<0,5,1{Long,Medium,Short,Ramp Down (-inf),Ramp Up (0dB),Ramp Up 2 (+6dB)}>Step 29 Mode
slider94:0<-1,1,0.01>Step 29 Curve Adjust
slider95:0<-1,1,0.01>Step 30 Value
slider96:0<0,5,1{Long,Medium,Short,Ramp Down (-inf),Ramp Up (0dB),Ramp Up 2 (+6dB)}>Step 30 Mode
slider97:0<-1,1,0.01>Step 30 Curve Adjust
slider98:0<-1,1,0.01>Step 31 Value
slider99:0<0,5,1{Long,Medium,Short,Ramp Down (-inf),Ramp Up (0dB),Ramp Up 2 (+6dB)}>Step 31 Mode
slider100:0<-1,1,0.01>Step 31 Curve Adjust
slider101:0<-1,1,0.01>Step 32 Value
slider102:0<0,5,1{Long,Medium,Short,Ramp Down (-inf),Ramp Up (0dB),Ramp Up 2 (+6dB)}>Step 32 Mode
slider103:0<-1,1,0.01>Step 32 Curve Adjust

@init
vals = 0; modes = 32; curves = 64;
last_out_gain = 0;

function apply_precision_curve(t, c) (
  c == 0 ? t : (
    c > 0 ? (
      // Logarithmic-style (fast then slow)
      1 - (1 - t)^(1 + c * 5);
    ) : (
      // Exponential-style (slow then fast)
      t^(1 + abs(c) * 5);
    );
  );
);

@slider
grid_idx = slider1;
grid_idx == 0 ? beat_div = 4;
grid_idx == 1 ? beat_div = 2;
grid_idx == 2 ? beat_div = 1;
grid_idx == 3 ? beat_div = 0.5;
grid_idx == 4 ? beat_div = 0.25;
grid_idx == 5 ? beat_div = 0.125;
grid_idx == 6 ? beat_div = 0.0625;
grid_idx == 7 ? beat_div = 0.03125;

pr_start = slider2; pr_stop = slider3;
att_s = slider4/1000; dec_s = slider5/1000; sus_v = slider6; rel_s = slider7/1000;

// Map Sliders to Memory
i=0; loop(32, 
  vals[i] = slider(8 + i*3);
  modes[i] = slider(9 + i*3);
  curves[i] = slider(10 + i*3);
  i+=1;
);

@sample
(play_state & 1) ? (
  t_beats = beat_position;
  t_steps = t_beats / beat_div;
  range = abs(pr_stop - pr_start) + 1;
  seq_pos = floor(t_steps) % range;
  
  step_idx = (pr_start <= pr_stop) ? (pr_start - 1 + seq_pos) : (pr_start - 1 - seq_pos);
  
  t_norm = t_steps - floor(t_steps);
  t_sec = t_norm * (beat_div * 60 / tempo);
  
  v_raw = vals[step_idx];
  m = modes[step_idx];
  curv = curves[step_idx];
  base_g = v_raw + 1;
  
  // 1. SHAPE LOGIC
  shape_g = 0;
  gate_len = (m == 1 ? 0.5 : (m == 2 ? 0.25 : 1.001));
  
  (m < 3) ? (
    t_norm < gate_len ? shape_g = base_g : shape_g = 0;
  ) : (
    c_norm = apply_precision_curve(t_norm, curv);
    m == 3 ? shape_g = base_g * (1 - c_norm); // Ramp Down
    m == 4 ? shape_g = base_g + (1.0 - base_g) * c_norm; // Ramp Up to 0dB
    m == 5 ? shape_g = base_g + (2.0 - base_g) * c_norm; // Ramp Up to +6dB
  );

  // 2. ADSR LOGIC
  env = 0;
  t_sec < (gate_len * (beat_div * 60 / tempo)) ? (
    t_sec < att_s ? (
      env = (att_s > 0 ? t_sec / att_s : 1);
    ) : (
      t_dec = t_sec - att_s;
      dec_s > 0 ? (
        env = 1.0 - (1.0 - sus_v) * (t_dec / dec_s);
        env < sus_v ? env = sus_v;
      ) : env = sus_v;
    )
  ) : (
    t_rel = t_sec - (gate_len * (beat_div * 60 / tempo));
    env = (rel_s > 0 ? sus_v * (1.0 - (t_rel / rel_s)) : 0);
    env < 0 ? env = 0;
  );

  target_g = shape_g * env;
  
  // 3. MICRO-SMOOTHING (Only for Clicks, 2ms window)
  last_out_gain = last_out_gain + (target_g - last_out_gain) * (1 - exp(-1/(0.002 * srate)));

  spl0 *= last_out_gain;
  spl1 *= last_out_gain;
) : (
  spl0 = spl1 = last_out_gain = 0;
);